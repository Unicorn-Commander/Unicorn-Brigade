# API Configuration
API_HOST=0.0.0.0
API_PORT=8100
API_TITLE=Unicorn Brigade API
API_VERSION=1.0.0
ENVIRONMENT=production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# UC/LiteLLM Gateway Configuration (BR-3.2)
# Per-org keys are OFF by default. To enable, Aaron must provision real gateway
# keys/budgets first, then map org ids to those keys here or via deployment
# secrets. Do not put live keys in git.
UC_GATEWAY_URL=
UC_GATEWAY_KEY=
UC_GATEWAY_PER_ORG_KEYS_ENABLED=false
UC_GATEWAY_ORG_KEYS_JSON={"org-uuid":{"api_key":"sk-org-placeholder","key_alias":"org-alias","max_budget":50}}

# Anthropic Configuration (optional)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Memory Provider Selection
# Vector memory backend. Currently: mem0 (Qdrant-backed).
MEMORY_PROVIDER=mem0

# mem0 Configuration (default vector store)
QDRANT_URL=http://brigade-qdrant:6333
QDRANT_COLLECTION=brigade_memories

# Graphiti Temporal Knowledge Graph (advanced memory)
# The temporal-memory tier is Graphiti over FalkorDB (see FalkorDB section below
# and app/memory/graphiti_manager.py). It uses an OpenAI-compatible endpoint for
# extraction + embeddings (defaults point at the local inference gateway).
MEMORY_LLM_BASE_URL=http://172.17.0.1:8085/v1
MEMORY_LLM_MODEL=Qwen3.6-35B-A3B-UD-Q4_K_XL
MEMORY_EMBED_BASE_URL=http://192.168.10.68:8086/v1
MEMORY_EMBED_MODEL=BAAI/bge-m3
MEMORY_EMBED_DIMS=1024
# Graph database name used by Graphiti inside FalkorDB
FALKORDB_DATABASE=brigade_memories

# PostgreSQL Configuration
POSTGRES_HOST=brigade-postgres
POSTGRES_PORT=5432
POSTGRES_USER=brigade
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=brigade

# ── Multi-tenant RLS role split (BR-1.2 / BR-1.3) ──────────────────────────────
# Brigade enforces per-org isolation with Postgres Row-Level Security. RLS is only
# real if the RUNTIME connects as a role that is SUBJECT to it — a superuser or a
# BYPASSRLS role silently defeats every policy. Two DSNs, split by purpose:
#
#   DATABASE_URL            RUNTIME app-role DSN (request traffic). MUST be a LOGIN
#                           role IN ROLE brigade_app, NOSUPERUSER + NOBYPASSRLS.
#                           On startup provision_app_role() creates/updates exactly
#                           this role (from these credentials) using the migration
#                           DSN, so you only have to point DATABASE_URL at it.
#   MIGRATION_DATABASE_URL  OWNER/ADMIN DSN — DDL, migrations, role provisioning,
#                           and the cross-tenant scheduler. Must be superuser or
#                           BYPASSRLS + CREATEROLE. Defaults to DATABASE_URL.
#
# Leaving both unset (single-role dev) keeps today's behavior: everything runs as
# the owner and RLS is present but bypassed — startup logs a loud warning. To turn
# isolation ON, set (uncomment) both, e.g.:
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://brigade:${POSTGRES_PASSWORD}@brigade-postgres:5432/brigade
#   DATABASE_URL=postgresql+asyncpg://brigade_app:CHANGE_ME_APP_PASSWORD@brigade-postgres:5432/brigade
# (docker-compose derives DATABASE_URL from POSTGRES_* by default; override it +
#  add MIGRATION_DATABASE_URL to adopt the split.)

# Redis Configuration
REDIS_HOST=brigade-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# Billing Configuration (Stripe)
# Also used by Stripe MCP Server for payment automation
# Get API key from: https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_000000000000000000000000

# Observability
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# Langfuse Observability (self-hosted)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# For docker-compose.langfuse.yml:
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me-langfuse-db-password
LANGFUSE_DB_NAME=langfuse
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
LANGFUSE_ENCRYPTION_KEY=your-64-char-hex-encryption-key-change-in-production
LANGFUSE_NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
LANGFUSE_URL=http://localhost:3001
LANGFUSE_SALT=your-salt-change-in-production

# Browser Automation (optional - requires: pip install browser-use && playwright install chromium)
BROWSER_USE_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=60
# For production browser automation (optional):
# BROWSER_USE_API_KEY=your-browser-use-cloud-api-key
# BROWSER_CDP_URL=ws://your-remote-browser:9222

# Code Sandbox
CODE_SANDBOX_ENABLED=true
CODE_SANDBOX_TIMEOUT=30

# FalkorDB Knowledge Graph (docker-compose.falkordb.yml)
FALKORDB_ENABLED=true
FALKORDB_HOST=brigade-falkordb
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
# FalkorDB Browser UI available at http://localhost:3002

# Slack Integration
# Create a Slack App at https://api.slack.com/apps
# Bot Token Scopes needed: chat:write, channels:read, channels:history, users:read, users:read.email, reactions:write, files:write
SLACK_BOT_TOKEN=xoxb-000000000000-000000000000-000000000000-000000000000
# User Token (optional) - for search and advanced features
# User Token Scopes needed: search:read
SLACK_USER_TOKEN=xoxb-000000000000-000000000000-000000000000-000000000000
# Signing Secret for webhook verification (found in App Settings > Basic Information)
SLACK_SIGNING_SECRET=your-signing-secret
# App ID (found in App Settings > Basic Information)
SLACK_APP_ID=A0123456789

# =============================================================================
# Email Provider Configuration
# =============================================================================
# Select your email provider: ms365, google, resend, sendgrid
EMAIL_PROVIDER=ms365

# Microsoft 365 Email (when EMAIL_PROVIDER=ms365)
# Create an App Registration in Azure AD with Mail.Send permission
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
MS365_CLIENT_ID=your-azure-app-client-id
MS365_TENANT_ID=your-azure-tenant-id
MS365_CLIENT_SECRET=your-azure-app-client-secret
MS365_USER_EMAIL=your-email@yourdomain.com

# Google Workspace Email (when EMAIL_PROVIDER=google)
# =============================================================================
# Option 1: OAuth2 Flow (for user-authorized access)
# Create OAuth2 credentials at: https://console.cloud.google.com/apis/credentials
# Enable Gmail API at: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# Required scopes: gmail.send, gmail.readonly, gmail.modify
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_USER_EMAIL=your-email@yourdomain.com

# Option 2: Service Account (for domain-wide delegation)
# Create a service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable domain-wide delegation in Google Admin Console
# Download the JSON key file and set the path below
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json
# GOOGLE_DELEGATED_USER=user-to-impersonate@yourdomain.com

# =============================================================================
# Google Calendar Integration
# =============================================================================
# Enable Google Calendar integration for the Meeting Scheduler agent
# Uses the same Google credentials as email (above)
# Required scopes: calendar, calendar.events, calendar.readonly
# Enable Calendar API at: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CREDENTIALS_FILE=config/google_calendar_credentials.json

# Resend Email (when EMAIL_PROVIDER=resend)
# Get API key from: https://resend.com
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# SendGrid Email (when EMAIL_PROVIDER=sendgrid)
# Get API key from: https://sendgrid.com
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Security & Authentication
# =============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://unicorncommander.ai

# API Authentication (Required in production)
# Master admin key for bootstrap/emergency access (generate with: openssl rand -hex 32)
# This key has full admin access - keep it secure and rotate regularly
BRIGADE_ADMIN_KEY=your-64-char-hex-admin-key-change-in-production

# Development-only bypass (DANGEROUS - NEVER use in production!)
# Set to "true" to skip API key validation during development
AUTH_BYPASS=false

# -----------------------------------------------------------------------------
# Keycloak / OIDC SSO (optional) — see docs/self-host-sso.md
# -----------------------------------------------------------------------------
# Off by default. When enabled, Brigade validates Keycloak-issued Bearer JWTs
# and (with a client secret) supports the browser authorization-code login flow.
BRIGADE_USE_KEYCLOAK=false
OIDC_ISSUER=https://auth.example.com/realms/uchub
KEYCLOAK_CLIENT_ID=brigade
# Optional aud to enforce; if unset, aud is not checked (azp is used instead)
# OIDC_AUDIENCE=brigade
# Optional JWKS URL override (default: <issuer>/protocol/openid-connect/certs)
# KEYCLOAK_JWKS_URL=
# JWKS cache TTL in seconds
OIDC_JWKS_TTL=3600

# Browser login flow (web UI) — confidential client
# KEYCLOAK_CLIENT_SECRET=change-me
# BRIGADE_CALLBACK_URL=https://brigade.example.com/api/auth/oidc/callback
# BRIGADE_FRONTEND_URL=https://brigade.example.com
# COOKIE_SECURE=true

# Email allowlist for early-access paths (comma-separated, case-insensitive).
# Empty = no allowlist restriction on top of normal auth.
BRIGADE_ALLOWED_EMAILS=

# Agent Configuration
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT=300
STREAM_ENABLED=true

# LiveKit Voice Configuration (docker-compose.livekit.yml)
# Self-hosted LiveKit server URL (WebSocket)
LIVEKIT_URL=ws://localhost:7880
# API key for LiveKit authentication (generate with: openssl rand -base64 32)
LIVEKIT_API_KEY=devkey
# API secret for JWT signing (at least 32 characters)
LIVEKIT_API_SECRET=REMOVED

# Voice Provider Configuration
# =============================================================================
# Choose between cloud-based or self-hosted providers.
# Self-hosted providers run locally without external API dependencies.

# STT (Speech-to-Text) Provider
# Cloud options: deepgram, whisper (OpenAI API), assemblyai
# Self-hosted options: faster-whisper, whisper-cpp, mlx-whisper
VOICE_STT_PROVIDER=faster-whisper

# STT Model (for self-hosted providers)
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
# Larger models are more accurate but require more resources
VOICE_STT_MODEL=large-v3-turbo

# STT Device (for self-hosted providers)
# Options: auto, cpu, cuda, mps
# auto: Automatically detect best available device
VOICE_STT_DEVICE=auto

# STT Compute Type (for self-hosted providers)
# Options: float32, float16, int8, int8_float16
# int8 is faster and uses less memory but slightly less accurate
VOICE_STT_COMPUTE_TYPE=float16

# STT Language (default language for transcription)
VOICE_STT_LANGUAGE=en

# TTS (Text-to-Speech) Provider
# Cloud options: openai, elevenlabs, cartesia
# Self-hosted options: kokoro, chatterbox, marvis, cosyvoice, custom
VOICE_TTS_PROVIDER=kokoro

# TTS Model (for self-hosted providers)
# Kokoro: kokoro-82m (lightweight, runs on CPU)
# Chatterbox: chatterbox (full), chatterbox-turbo (faster)
# Marvis: marvis-tts (Apple Silicon only)
# CosyVoice: cosyvoice2-0.5b (ultra-low latency)
VOICE_TTS_MODEL=kokoro-82m

# TTS Voice (default voice ID)
# Kokoro voices: af_bella, af_heart, af_nicole, af_sarah, af_sky,
#                am_adam, am_michael, bf_emma, bf_isabella, bm_george, bm_lewis
# Marvis voices: af_sky, am_michael
# Chatterbox: default (or cloned voice IDs)
# CosyVoice: default, male_en, female_en, male_zh, female_zh (or cloned)
# OpenAI voices: alloy, echo, fable, onyx, nova, shimmer
VOICE_TTS_VOICE=af_bella

# TTS Sample Rate (audio output quality)
# Kokoro/Chatterbox/Marvis: 24000
# CosyVoice: 22050
VOICE_TTS_SAMPLE_RATE=24000

# TTS Speed (speech speed multiplier)
VOICE_TTS_SPEED=1.0

# TTS Device (auto, cpu, cuda, mps)
VOICE_TTS_DEVICE=auto

# Custom TTS Model (for custom provider)
# Path to ONNX or PyTorch model file
# CUSTOM_TTS_MODEL_PATH=/path/to/custom/tts/model.onnx
# CUSTOM_TTS_CONFIG_PATH=/path/to/custom/tts/config.json

# Voice Cloning Sample (for providers that support it)
# Path to 5-10 second audio sample for voice cloning
# VOICE_TTS_VOICE_SAMPLE=/path/to/voice/sample.wav

# VAD (Voice Activity Detection) Settings
# Enable VAD to filter out non-speech audio
VOICE_VAD_ENABLED=true
VOICE_VAD_THRESHOLD=0.5
VOICE_VAD_MIN_SPEECH_MS=250
VOICE_VAD_MIN_SILENCE_MS=500

# Custom Model Paths (optional - for local model storage)
# VOICE_STT_MODEL_PATH=/path/to/custom/whisper/models
# VOICE_TTS_MODEL_PATH=/path/to/custom/tts/models

# =============================================================================
# Cloud Provider API Keys (only needed if using cloud providers)

# Deepgram Configuration (for STT)
# Get API key from: https://console.deepgram.com
DEEPGRAM_API_KEY=your-deepgram-api-key

# ElevenLabs Configuration (for TTS)
# Get API key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# OpenAI TTS voice (when using openai TTS provider)
OPENAI_TTS_VOICE=nova

# ElevenLabs voice ID (when using elevenlabs TTS provider)
ELEVENLABS_VOICE_ID=Rachel

# =============================================================================
# MCP (Model Context Protocol) Configuration
# =============================================================================

# GitHub MCP Server
# Create PAT at: https://github.com/settings/tokens
# Required scopes: repo, read:packages, read:org
GITHUB_TOKEN=ghp_000000000000000000000000000000000000

# Linear MCP Server (Phase 1 - Jan 2026)
# Create API key at: https://linear.app/settings/api
# Personal API key with read/write access to issues and projects
LINEAR_API_KEY=lin_api_your_linear_api_key

# Notion MCP Server (Phase 1 - Jan 2026)
# Create integration at: https://www.notion.so/my-integrations
# Requires: Read content, Update content, Insert content permissions
# Share target pages/databases with the integration
NOTION_API_KEY=secret_your_notion_integration_token

# =============================================================================
# Phase 2 MCP Servers - January 2026
# =============================================================================

# Airtable MCP Server
# Create API key at: https://airtable.com/create/tokens
# Personal access token with data.records:read, data.records:write, schema.bases:read permissions
# Get Base ID from URL: https://airtable.com/YOUR_BASE_ID/...
AIRTABLE_API_KEY=patYourAirtablePersonalAccessToken
AIRTABLE_BASE_ID=appYourAirtableBaseId

# Vercel MCP Server
# Create token at: https://vercel.com/account/tokens
# Requires deployment and project management permissions
# Team ID is optional (for team deployments): found in team settings URL
VERCEL_TOKEN=your_vercel_token
VERCEL_TEAM_ID=team_your_team_id

# Cloudflare MCP Server
# Create API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Workers Scripts:Edit, Workers KV Storage:Edit, Workers R2 Storage:Edit, Zone:Read, DNS:Edit
# Account ID found in dashboard URL or Workers & Pages overview
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Supabase MCP Server
# Project URL and keys from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Anon key is safe for client-side use (RLS policies apply)
# Service role key has admin access - keep secure, never expose client-side
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key

# =============================================================================
# Phase 3 MCP Servers - January 2026
# =============================================================================

# MongoDB MCP Server
# Connection string format: mongodb://username:password@host:port/database
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
# Get connection string from: https://cloud.mongodb.com/
# Database name is the default database to use (can be overridden per operation)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=your_database_name

# Twilio MCP Server
# Get credentials from: https://console.twilio.com/
# Account SID and Auth Token are found in Account Info section
# Phone number must be a Twilio-verified number (format: +1234567890)
# Required for sending SMS, making calls, WhatsApp messaging
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry MCP Server
# Create project at: https://sentry.io/
# DSN (Data Source Name) from: Project Settings > Client Keys (DSN)
# Organization slug from URL: https://sentry.io/organizations/YOUR_ORG/
# Project slug from URL: https://sentry.io/organizations/YOUR_ORG/projects/YOUR_PROJECT/
# Required for error tracking, issue management, performance monitoring
SENTRY_DSN=https://public_key@sentry.io/project_id
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-slug

# HubSpot MCP Server
# Create private app at: https://app.hubspot.com/private-apps/YOUR_PORTAL_ID
# Required scopes: crm.objects.contacts, crm.objects.companies, crm.objects.deals,
#                  crm.objects.tickets, automation, content, reports
# Portal ID (Hub ID) found in: Settings > Account Setup > Account Defaults
# Copy the access token from private app settings
HUBSPOT_API_KEY=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_PORTAL_ID=12345678

# =============================================================================
# Phase 4 MCP Servers - January 2026
# =============================================================================

# Shopify MCP Server
# Create private app at: https://YOUR_SHOP.myshopify.com/admin/settings/apps/development
# Required scopes: read_products, write_products, read_orders, write_orders, read_customers,
#                  write_customers, read_inventory, write_inventory, read_fulfillments, write_fulfillments,
#                  read_price_rules, write_price_rules, read_analytics
# Shop URL format: your-store-name.myshopify.com (without https://)
# Admin API access token from private app credentials
# API version format: 2024-01 (use latest stable version from Shopify changelog)
SHOPIFY_SHOP_URL=your-store-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# Salesforce MCP Server
# Create connected app at: Setup > Apps > App Manager > New Connected App
# Required scopes: api, refresh_token, offline_access
# Instance URL from login: https://your-instance.salesforce.com (or https://your-domain.my.salesforce.com)
# OAuth2 credentials from connected app settings
# Username/Password: Your Salesforce login credentials (use security token for API access)
# For sandbox: Use test.salesforce.com instance and sandbox credentials
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_CLIENT_ID=3MVG9xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SALESFORCE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
SALESFORCE_USERNAME=your-email@company.com
SALESFORCE_PASSWORD=your_password_with_security_token

# Jira MCP Server
# Create API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Host format: your-domain.atlassian.net (without https://)
# Email: Your Atlassian account email
# API token: Generate from account settings (not same as personal access token)
# Required permissions: Browse projects, Create issues, Edit issues, Administer projects
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Zendesk MCP Server
# Create API token at: Admin Center > Apps and integrations > APIs > Zendesk API > Add API token
# Subdomain: Your Zendesk subdomain (e.g., "yourcompany" from yourcompany.zendesk.com)
# Email: Agent email with admin or agent permissions
# API token: Copy from Zendesk API settings (enable token access first)
# Required permissions: Full access or custom role with ticket/user/organization read/write
ZENDESK_SUBDOMAIN=yourcompany
ZENDESK_EMAIL=agent@yourcompany.com
ZENDESK_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Phase 5 MCP Servers - January 2026
# =============================================================================

# Intercom MCP Server
# Create access token at: https://app.intercom.com/a/apps/YOUR_APP_ID/developer-hub/app-packages
# Required scopes: Read and manage conversations, contacts, messages, tickets, articles, companies
# App ID found in: Settings > General > Your Intercom app settings
# Access token type: Create a new Developer App in Developer Hub with required permissions
INTERCOM_ACCESS_TOKEN=dG9rOmxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INTERCOM_APP_ID=xxxxxxxx

# Asana MCP Server
# Create personal access token at: https://app.asana.com/0/my-apps
# Required permissions: Full access to tasks, projects, workspaces, portfolios, goals
# Workspace GID found in: https://app.asana.com/0/WORKSPACE_GID (from URL)
# Or get it via API: https://app.asana.com/api/1.0/workspaces
ASANA_ACCESS_TOKEN=1/xxxxxxxxxxxxxxxxxxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASANA_WORKSPACE_GID=REMOVED

# Trello MCP Server
# Create API key and token at: https://trello.com/power-ups/admin
# API key is found in: https://trello.com/app-key
# Generate token: Click "Token" link on API key page (requires authorization)
# Required permissions: Read and write access to boards, lists, cards, members
TRELLO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TRELLO_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QuickBooks Online MCP Server
# Create app at: https://developer.intuit.com/app/developer/qbo/docs/get-started
# OAuth2 credentials from: Intuit Developer Dashboard > App > Keys & credentials
# Realm ID (Company ID): Found in QuickBooks URL or from OAuth callback
# Refresh token: Obtained via OAuth2 flow (exchange authorization code)
# Required scopes: com.intuit.quickbooks.accounting (full accounting access)
QUICKBOOKS_CLIENT_ID=ABxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_REALM_ID=REMOVED
QUICKBOOKS_REFRESH_TOKEN=AB11xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Drive MCP (optional)
# Service account JSON file path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Brave Search API (optional)
# Get key at: https://brave.com/search/api/
BRAVE_API_KEY=your-brave-search-api-key

# =============================================================================
# Phase 6 MCP Servers - January 2026
# =============================================================================

# Mailchimp MCP Server
# Create API key at: https://admin.mailchimp.com/account/api/
# Account > Extras > API keys > Create A Key
# Server prefix is the data center identifier (e.g., us1, us2, etc.) from your Mailchimp login URL
# Format: https://YOURPREFIX.admin.mailchimp.com (extract YOURPREFIX)
# Required permissions: Read/Write access to campaigns, lists, templates, reports
MAILCHIMP_API_KEY=your_mailchimp_api_key-us1
MAILCHIMP_SERVER_PREFIX=us1

# ActiveCampaign MCP Server
# Create API key at: Settings > Developer > API Access
# Account URL format: https://youraccountname.api-us1.com (your account subdomain + region)
# Required permissions: Full API access (contacts, deals, automations, campaigns, lists, tags)
# API key is account-specific with full access to your ActiveCampaign instance
ACTIVECAMPAIGN_URL=https://youraccountname.api-us1.com
ACTIVECAMPAIGN_API_KEY=your_activecampaign_api_key

# Calendly MCP Server
# Create personal access token at: https://calendly.com/integrations/api_webhooks
# Navigate to: Account > Integrations > API & Webhooks
# Required permissions: Read and write access to event types, scheduled events, users, webhooks
# Webhook signing key is optional (for webhook verification)
# Get from webhook settings after creating webhook subscriptions
CALENDLY_API_KEY=your_calendly_personal_access_token
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key

# DocuSign MCP Server
# Create integration at: https://developers.docusign.com/
# OAuth2 JWT Grant application with RSA keypair
# Integration key: Client ID from app settings
# User ID: GUID from DocuSign admin (Settings > Apps and Keys > User ID)
# Account ID: API Account ID from same settings page
# Private Key: Base64-encoded RSA private key from keypair (generate in app settings)
# Required scopes: signature, impersonation
# Note: DocuSign uses JWT authentication - requires OAuth2 consent grant first
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_USER_ID=your_docusign_user_guid
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_PRIVATE_KEY=your_base64_encoded_private_key

# =============================================================================
# Code Sandbox Configuration
# =============================================================================
# Supports both self-hosted Docker and E2B cloud

# Sandbox type: docker, e2b, or auto (prefers Docker, falls back to E2B)
SANDBOX_TYPE=auto

# Prefer Docker over E2B when both are available
SANDBOX_PREFER_DOCKER=true

# Allow E2B fallback when Docker is unavailable
SANDBOX_ALLOW_E2B_FALLBACK=true

# Docker images for code execution
SANDBOX_DOCKER_PYTHON=python:3.11-slim
SANDBOX_DOCKER_NODE=node:20-slim
SANDBOX_DOCKER_SHELL=alpine:latest

# Execution limits
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY=512m
SANDBOX_MAX_CPU=1

# Network access (disable for security)
SANDBOX_NETWORK_ENABLED=false

# E2B Cloud (optional fallback)
# Get API key at: https://e2b.dev
E2B_API_KEY=

# =============================================================================
# HuggingFace Integration (Medical AI Models)
# =============================================================================
# Get API token at: https://huggingface.co/settings/tokens
# Required for medical AI features: entity extraction, image analysis, etc.
# Free tier available with rate limits; Pro tier for higher throughput
HUGGINGFACE_API_TOKEN=hf_your_huggingface_api_token

# =============================================================================
# Browser Automation (Playwright/Browserless)
# =============================================================================

# Browserless Chrome URL (self-hosted)
BROWSERLESS_URL=http://localhost:3333

# Playwright MCP settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=60000

# =============================================================================
# Phase 7 MCP Servers - January 2026
# =============================================================================

# Ahrefs SEO Platform
# Create API token at: https://ahrefs.com/api/settings
# Navigate to: Settings > API > Create new token
# Required permissions: Site Explorer, Keywords Explorer, Site Audit, Rank Tracker, Content Explorer
# Standard plan minimum ($99/month) - API access requires paid plan
# Rate limits: 500 requests/day (Standard), 2000/day (Advanced)
AHREFS_API_KEY=your_ahrefs_api_token

# SEMrush Marketing Toolkit
# Create API key at: https://www.semrush.com/api-analytics/
# Navigate to: Account > API > Create new key
# Required subscriptions: SEMrush API units package (separate from main subscription)
# API units: consumed per request (1-10 units depending on report type)
# Standard rate: 10,000 API units/month ($200), can purchase additional units
# Required scopes: Domain Analytics, Keyword Analytics, Backlinks, Site Audit, Position Tracking
SEMRUSH_API_KEY=your_semrush_api_key

# Zapier Automation Platform
# Create API key at: https://zapier.com/app/settings/api-clients
# Navigate to: Settings > APIs & Services > API Clients
# Create new API client with OAuth credentials
# Note: Zapier Platform API requires Team/Company plan ($299+/month)
# Free/Starter plans have read-only access to Zaps
# Full automation API (create/update Zaps) requires Team plan or higher
# Alternative: Use Zapier Platform CLI for local development (free)
ZAPIER_API_KEY=your_zapier_platform_api_key

# Make Automation Platform (formerly Integromat)
# Create API token at: https://www.make.com/en/api-documentation
# Navigate to: Organization > API > Generate new token
# Team ID: Found in organization settings URL (https://www.make.com/en/organization/TEAM_ID)
# Required plan: Core plan minimum ($9/month) for API access
# Free plan has no API access - Core/Pro/Enterprise only
# Rate limits: 120 requests/minute per team
# Required permissions: Scenarios (read/write), Connections, Data stores, Webhooks
MAKE_API_KEY=your_make_api_token
MAKE_TEAM_ID=your_make_team_id

# =============================================================================
# Phase 8 MCP Servers - January 2026
# Product Analytics and Customer Data Platforms
# =============================================================================

# Amplitude Analytics
# Create account at: https://amplitude.com/
# Get API credentials from: Settings > Projects > YOUR_PROJECT > General
# API Key and Secret Key: Found in project settings under "API Keys" section
# Project ID: Found in project settings or URL (e.g., 123456)
# Required plan: Starter plan minimum (free for up to 10M events/month)
# Growth+ plan required for advanced features (Personas, Experiment, etc.)
# Rate limits: 30 requests/second per project (Starter), 100/sec (Growth+)
# Required permissions: Event tracking, cohort creation, dashboard access, export data
# Use cases: User behavior tracking, funnel analysis, retention cohorts, A/B testing
AMPLITUDE_API_KEY=your_amplitude_api_key
AMPLITUDE_SECRET_KEY=your_amplitude_secret_key
AMPLITUDE_PROJECT_ID=123456

# Mixpanel Analytics
# Create account at: https://mixpanel.com/
# Get credentials from: Project Settings > Access Keys
# Project Token: For event tracking (client-side or server-side)
# API Secret: For query API access (reports, cohorts, etc.)
# Service Account: For admin API operations (user management, etc.)
# Required plan: Free plan (up to 20M events/month), Growth plan for advanced features
# Rate limits: 2000 requests/hour (Free), 4000/hour (Growth), unlimited (Enterprise)
# Required permissions: Data ingestion, query API, cohort management, experiments
# Use cases: Event tracking, user journey analysis, retention reports, predictive analytics
MIXPANEL_PROJECT_TOKEN=your_mixpanel_project_token
MIXPANEL_API_SECRET=your_mixpanel_api_secret
MIXPANEL_SERVICE_ACCOUNT=your_mixpanel_service_account_username

# Segment Customer Data Platform
# Create account at: https://segment.com/
# Get credentials from: Workspace > Settings > API Access
# Write Key: For client-side event tracking (found in source settings)
# Access Token: For Config API and workspace management (create in API Access)
# Workspace Slug: Your workspace identifier (e.g., "my-company" from URL)
# Required plan: Free plan (2 sources, 1000 MTU), Team plan ($120/mo) for production
# Rate limits: 500 requests/second per source (Free), custom limits for paid plans
# Required permissions: Source management, destination management, tracking plan, warehouses
# Use cases: Unified data collection, 300+ integrations, data warehouse sync, identity resolution
SEGMENT_WRITE_KEY=your_segment_write_key
SEGMENT_ACCESS_TOKEN=your_segment_access_token
SEGMENT_WORKSPACE_SLUG=your-workspace-slug

# PostHog Open-Source Analytics
# Self-hosted option: https://posthog.com/docs/self-host
# Cloud option: https://app.posthog.com/
# Get credentials from: Project > Settings > Project API Key
# API Key: Project-specific API key for event ingestion and queries
# Host: For cloud: https://app.posthog.com, for self-hosted: your instance URL
# Project ID: Found in project settings or URL (numeric ID)
# Required plan: Free cloud (1M events/month), $0.000225/event after, or self-hosted (unlimited)
# Rate limits: 100 requests/second per project (cloud), unlimited (self-hosted)
# Required permissions: Event capture, insights, recordings, feature flags, experiments
# Use cases: Self-hosted analytics, session replay, feature flags, A/B testing, heatmaps
POSTHOG_API_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://app.posthog.com
POSTHOG_PROJECT_ID=12345

# =============================================================================
# Phase 9 MCP Servers - January 2026
# UX & Product Analytics Platforms
# =============================================================================

# Heap Auto-Capture Analytics
# Create account at: https://heap.io/
# Get credentials from: Account Settings > Projects > API Keys
# App ID: Found in project settings (8-digit numeric ID)
# API Key: Server-side API key for backend integrations
# Account ID: Your Heap account identifier (numeric)
# Required plan: Growth plan minimum ($3,600/year) - Free plan has limited API access
# Rate limits: 600 requests/minute per account
# Required permissions: Event data access, user data, segments, funnels, SQL queries
# Use cases: Retroactive analytics, event autocapture, session replay, user journey analysis
# Unique features: No manual instrumentation, analyze past events, automatic event capture
HEAP_APP_ID=12345678
HEAP_API_KEY=your_heap_server_api_key
HEAP_ACCOUNT_ID=your_heap_account_id

# Pendo Product Experience Platform
# Create account at: https://www.pendo.io/
# Get credentials from: Settings > Integrations > API Keys
# API Key: Integration key for API access (starts with "int.")
# Subdomain: Your Pendo subdomain (e.g., "yourcompany" from yourcompany.pendo.io)
# Integration Key: Alternative key format for certain API endpoints
# Required plan: Starter plan minimum ($7,000/year) - Free trial available
# Rate limits: 100 requests/minute per account (Starter), 300/min (Growth)
# Required permissions: Guides, features, segments, pages, polls, visitor data, analytics
# Use cases: In-app guidance, feature adoption tracking, user sentiment, product roadmap feedback
# Unique features: Product-led onboarding, NPS surveys, feature tagging, adoption analytics
PENDO_API_KEY=int.your_pendo_integration_key
PENDO_SUBDOMAIN=yourcompany
PENDO_INTEGRATION_KEY=your_pendo_integration_key

# FullStory Digital Experience Intelligence
# Create account at: https://www.fullstory.com/
# Get credentials from: Settings > Integrations & API Keys > API Keys
# API Key: Create new API key with required scopes
# Org ID: Your organization identifier (e.g., "ABCD1")
# Required plan: Business plan minimum ($199/month for 5K sessions) - Enterprise for advanced features
# Rate limits: 400 requests/minute per org (Business), 1000/min (Enterprise)
# Required permissions: Session replay, events, users, segments, funnels, search, exports
# Use cases: Session replay, rage clicks, conversion funnels, frustrated user detection
# Unique features: DXI (Digital Experience Intelligence), frustration signals, omnisearch
FULLSTORY_API_KEY=your_fullstory_api_key
FULLSTORY_ORG_ID=ABCD1

# Hotjar UX Optimization Platform
# Create account at: https://www.hotjar.com/
# Get credentials from: Account Settings > API Keys
# API Key: Create API key with full access permissions
# Site ID: Your site identifier (6-7 digit numeric, found in site settings)
# Required plan: Plus plan minimum ($39/month) - Business plan for advanced features
# Rate limits: 600 requests/hour per account (Plus), 1200/hour (Business)
# Required permissions: Heatmaps, recordings, surveys, feedback, polls, form analytics
# Use cases: Heatmaps, session recordings, surveys, feedback widgets, form analytics
# Unique features: Click/move/scroll heatmaps, on-site surveys, feedback widgets, form analytics
HOTJAR_API_KEY=your_hotjar_api_key
HOTJAR_SITE_ID=1234567

# =============================================================================
# iLO / REDFISH BMC MANAGEMENT (optional agent: CWO Lights-Out)
# =============================================================================
# Operate servers' OUT-OF-BAND iLO management processors over Redfish (firmware /
# power / thermal). The bmc_* tools register ONLY when ILO_TARGETS is set.
# JSON map target-name -> {host, user, password_env}. The password is NEVER in
# this JSON — password_env names the env var that holds it.
# ILO_TARGETS={"myserver":{"host":"10.0.0.10","user":"Administrator","password_env":"ILO_MYSERVER_PASS"}}
ILO_TARGETS=
# ILO_MYSERVER_PASS=
# DORMANT mutating rail. Reads always work; flash/power PREVIEW by default and
# only execute when a human flips this to 1 to arm a maintenance window (and the
# call sets dry_run=false). Keep it 0 in normal operation.
ILO_ALLOW_MUTATE=0
# ILO_FW_DIR=            # optional allow-list dir firmware files must live under
# ILO_TIMEOUT=30.0
# ILO_FLASH_TIMEOUT=300.0

# =============================================================================
# KNOWLEDGE-OPS (optional internal grounding KB — any agent)
# =============================================================================
# Grounds agents in an internal SOPs/runbooks KB. knowledge_ops_* tools register
# ONLY when set. In-cluster: KNOWLEDGE_OPS_URL=http://knowledge-ops:8765
KNOWLEDGE_OPS_URL=

# Deployment-private sibling apps (optional). One or more JSON files, separated
# with ':', in the same list format as app/data/sibling_apps.json. Their entries
# are merged after the bundled apps, and a same-name entry replaces its bundled
# counterpart. Use this instead of bind-mounting a replacement sibling_apps.json,
# which freezes the bundled list. Unset = bundled apps only.
# BRIGADE_SIBLING_APPS_EXTRA=/app/config/sibling_apps.private.json
# Each entry may include "orgs": ["majiks", "00000000-0000-0000-0000-000000000001"].
# Entries match organizations.slug or organizations.id. Omitted/null = global;
# [] = unavailable to every org. Unknown entries are ignored with a warning.
# Listing and execution use the request's bound org, including delegated calls
# and the shared default org. tool_catalog.orgs (nullable JSON) can restrict an
# individual tool too; when both scopes exist, BOTH must allow the request org.
# Sibling config loads at startup; DB scopes refresh per request and the org
# ID/slug directory is cached for up to 60 seconds.
# Legacy static bearer fallback for the direct knowledge_ops_* tools.
# KNOWLEDGE_OPS_TOKEN=
# Prefer Keycloak client credentials by setting all three values below.
# KNOWLEDGE_OPS_OIDC_TOKEN_URL=
# KNOWLEDGE_OPS_OIDC_CLIENT_ID=
# KNOWLEDGE_OPS_OIDC_CLIENT_SECRET=
# Optional token request parameters:
# KNOWLEDGE_OPS_OIDC_AUDIENCE=
# KNOWLEDGE_OPS_OIDC_SCOPE=
# KNOWLEDGE_OPS_TIMEOUT=30.0
