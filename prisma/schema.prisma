// Unicorn Command & Control - Database Schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== CORE MODELS ====================

model Agent {
  id              String           @id @default(cuid())
  name            String
  displayName     String?
  title           String?          // Chief Agent Engineering Officer, etc.
  type            String           // orchestrator, team_lead, individual
  domain          String?          // financial, legal, investigation, meta, etc.
  subdomain       String?          // cybersecurity, data_science, etc.
  department      String?
  rank            String?          // General, Colonel, Captain, etc.
  avatar          String?          // Profile picture URL or emoji
  avatarUrl       String?
  avatarStyle     String?          // unicorn, professional, cartoon, etc.
  bio             String?
  persona         String           @default("")
  systemPrompt    String           @default("")
  status          String           @default("inactive") // active, inactive, busy, draft, archived
  capabilities    String           @default("[]") // JSON array
  memory          String           @default("{}") // JSON object
  performance     String           @default("{}") // JSON metrics

  // AI Model Settings
  model           String           @default("gpt-4-turbo")
  temperature     Float            @default(0.7)
  maxTokens       Int              @default(4096)

  // A2A Protocol Fields
  requiresAuth    Boolean          @default(false)
  pricingModel    String?          // free, pay_per_use, subscription
  basePrice       Float?

  // Creation metadata
  createdBy       String?          // User ID who created
  createdByAgent  String?          // Agent ID if created by another agent
  version         String           @default("1.0.0")

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  messages        AgentMessage[]
  tasks           AgentTask[]
  orchestrations  Orchestration[]  @relation("OrchestratorAgent")
  participations  Orchestration[]  @relation("ParticipantAgent")
  memories        Memory[]
  agentTools      AgentTool[]
  apiKeys         AgentApiKey[]

  @@index([domain])
  @@index([status])
  @@index([type])
  @@index([rank])
}

model AgentMessage {
  id              String           @id @default(cuid())
  agentId         String
  role            String           // user, assistant, system
  content         String
  metadata        String           @default("{}") // JSON
  createdAt       DateTime         @default(now())

  agent           Agent            @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([createdAt])
}

model AgentTask {
  id              String           @id @default(cuid())
  agentId         String
  orchestrationId String?
  title           String
  description     String
  status          String           @default("pending") // pending, in_progress, completed, failed
  priority        Int              @default(5)
  result          String?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  agent           Agent            @relation(fields: [agentId], references: [id])
  orchestration   Orchestration?   @relation(fields: [orchestrationId], references: [id])

  @@index([agentId])
  @@index([status])
  @@index([orchestrationId])
}

model Orchestration {
  id              String           @id @default(cuid())
  name            String
  orchestratorId  String
  type            String           // mission, investigation, analysis, etc.
  status          String           @default("planning") // planning, executing, completed, failed
  config          String           @default("{}") // JSON configuration
  result          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  orchestrator    Agent            @relation("OrchestratorAgent", fields: [orchestratorId], references: [id])
  participants    Agent[]          @relation("ParticipantAgent")
  tasks           AgentTask[]

  @@index([orchestratorId])
  @@index([status])
}

model Memory {
  id              String           @id @default(cuid())
  agentId         String?
  type            String           // episodic, semantic, procedural
  scope           String           // individual, team, global
  category        String?
  content         String
  embedding       String?          // Vector embedding for similarity search
  metadata        String           @default("{}")
  accessCount     Int              @default(0)
  lastAccessedAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  agent           Agent?           @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([type])
  @@index([scope])
  @@index([category])
}

model Tool {
  id              String           @id @default(cuid())
  name            String           @unique
  domain          String?          // Which domain this tool belongs to
  type            String           // mcp, python, api, custom
  description     String
  schema          String           // JSON schema for parameters
  implementation  String?          // Code or implementation details
  endpoint        String?          // For API tools
  script          String?          // For Python/custom tools
  mcpServer       String?          // MCP server identifier
  version         String           @default("1.0.0")
  isActive        Boolean          @default(true)
  usageCount      Int              @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  agentTools      AgentTool[]

  @@index([type])
  @@index([isActive])
  @@index([domain])
}

model Workflow {
  id              String           @id @default(cuid())
  name            String
  description     String
  type            String           // sequential, parallel, conditional
  definition      String           // JSON workflow definition
  triggers        String           @default("[]") // JSON array of triggers
  isActive        Boolean          @default(true)
  lastRunAt       DateTime?
  runCount        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive])
  @@index([type])
}

model AIProvider {
  id              String           @id @default(cuid())
  name            String
  type            String           // openrouter, openai, anthropic, etc.
  endpoint        String
  apiKey          String           // Encrypted
  config          String           @default("{}") // JSON config
  isDefault       Boolean          @default(false)
  isActive        Boolean          @default(true)
  usageStats      String           @default("{}")
  lastUsedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type])
  @@index([isDefault])
  @@index([isActive])
}

model User {
  id              String           @id @default(cuid())
  username        String           @unique
  email           String           @unique
  password        String           // Hashed
  role            String           @default("operator") // admin, operator, viewer
  permissions     String           @default("[]") // JSON array
  settings        String           @default("{}")
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions        Session[]

  @@index([role])
}

model Session {
  id              String           @id @default(cuid())
  userId          String
  token           String           @unique
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

// ==================== AGENT BUILDER MODELS ====================

model AgentTool {
  id              String           @id @default(cuid())
  agentId         String
  toolId          String
  config          String           @default("{}") // Tool-specific configuration
  isEnabled       Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool            Tool             @relation(fields: [toolId], references: [id])

  @@unique([agentId, toolId])
  @@index([agentId])
  @@index([toolId])
}

model AgentApiKey {
  id              String           @id @default(cuid())
  agentId         String
  name            String
  keyHash         String           // Hashed API key
  keyPrefix       String           // First 8 chars for identification
  permissions     String           @default("[]") // JSON array of permissions
  rateLimit       Int?             // Requests per minute
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  usageCount      Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  agent           Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([keyPrefix])
}