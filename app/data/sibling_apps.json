[
  {
    "name": "accounting-ops",
    "namespace": "accounting-ops",
    "transport": "mcp",
    "url_env": "ACCOUNTING_OPS_MCP_URL",
    "default_url": "https://accounting-ops.magicunicorn.dev/mcp/",
    "token_env": "ACCOUNTING_OPS_MCP_TOKEN",
    "token_required": true,
    "timeout": 15,
    "tools": [
      "accounting-ops.get_p_and_l",
      "accounting-ops.get_balance_sheet",
      "accounting-ops.get_cash_position",
      "accounting-ops.get_runway",
      "accounting-ops.get_trial_balance",
      "accounting-ops.list_pending_approvals",
      "accounting-ops.list_recent_transactions",
      "accounting-ops.flag_for_cpa_review"
    ],
    "allow_writes": [],
    "aliases": [
      {"alias": "get_p_and_l", "target": "accounting-ops.get_p_and_l"},
      {"alias": "get_balance_sheet", "target": "accounting-ops.get_balance_sheet"},
      {"alias": "get_cash_position", "target": "accounting-ops.get_cash_position"},
      {"alias": "get_runway", "target": "accounting-ops.get_runway"},
      {"alias": "get_trial_balance", "target": "accounting-ops.get_trial_balance"},
      {"alias": "list_pending_approvals", "target": "accounting-ops.list_pending_approvals"},
      {"alias": "list_recent_transactions", "target": "accounting-ops.list_recent_transactions"},
      {"alias": "flag_for_cpa_review", "target": "accounting-ops.flag_for_cpa_review"}
    ]
  },
  {
