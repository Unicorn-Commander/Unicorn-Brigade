      "customer-ops.list_customer_invoices"
    ],
    "allow_writes": [],
    "aliases": [
      {"alias": "get_customer_360", "target": "customer-ops.get_customer_360"},
      {"alias": "list_customers", "target": "customer-ops.list_customers"},
      {"alias": "pipeline_board", "target": "customer-ops.pipeline_board"},
      {"alias": "triage_customer", "target": "customer-ops.triage_customer"},
      {"alias": "draft_followup", "target": "customer-ops.draft_followup"},
