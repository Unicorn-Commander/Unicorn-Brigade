# Unicorn Brigade — Production Environment Configuration (TEMPLATE)
# Copy this file to .env.production (or .env) and fill in real values before
# deploying. Never commit the filled-in copy — .env.production is gitignored.
#
#   cp .env.production.example .env.production
#   # Edit .env.production with your actual passwords and keys
#   ./deploy.sh

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8100
ENVIRONMENT=production

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=brigade
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=brigade
DATABASE_URL=postgresql+asyncpg://brigade:CHANGE_ME@brigade-postgres:5432/brigade
DATABASE_URL_SYNC=postgresql://brigade:REMOVED@brigade-postgres:5432/brigade

# ── Ops-Center LLM ─────────────────────────────────────────────────────────
OPS_CENTER_URL=https://unicorncommander.ai
# Shared secret for service-delegation auth. MUST be a strong random value
# (e.g. `openssl rand -hex 32`). If unset or left as CHANGE_ME, service
# delegation fails closed (503).
BRIGADE_SERVICE_KEY=CHANGE_ME
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# ── Vector DB ───────────────────────────────────────────────────────────────
QDRANT_URL=http://brigade-qdrant:6333
QDRANT_COLLECTION=brigade_memories

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=brigade-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME
CORS_ORIGINS=http://localhost:3000,https://brigade.unicorncommander.ai

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
