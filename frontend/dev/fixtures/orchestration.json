    {
      "id": "delegation-chain",
      "steps": [
        {
          "at": 0,
          "actor": "general",
          "type": "agent_started",
          "data": {
            "task": "{{task}}"
          },
          "message": "The General started working"
        },
        {
          "at": 600,
          "actor": "general",
          "type": "agent_thinking",
          "data": {
            "thought": "Which desk owns this? Delegating to the lead."
          },
          "message": "Breaking the task into subtasks"
        },
        {
          "at": 1400,
          "actor": "general",
          "type": "agent_invocation",
          "to": "lead",
          "protocol": "internal",
          "purpose": "{{task}}"
        },
        {
          "at": 1500,
          "actor": "lead",
          "type": "agent_started",
          "data": {
            "task": "{{task}}"
          }
        },
        {
          "at": 2100,
          "actor": "lead",
          "type": "agent_thinking",
          "data": {
            "thought": "Need current data before answering."
          }
        },
        {
          "at": 2700,
          "actor": "lead",
          "type": "tool_call",
          "tool": "web_search",
          "arguments": {
            "query": "{{task}}",
            "max_results": 5
          }
        },
        {
          "at": 4000,
          "actor": "lead",
          "type": "tool_result",
          "tool": "web_search",
          "result": {
            "count": 5
          }
        },
        {
          "at": 4600,
