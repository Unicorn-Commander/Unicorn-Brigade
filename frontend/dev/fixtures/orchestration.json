          "type": "agent_responding",
          "data": {}
        },
        {
          "at": 11200,
          "actor": "general",
          "type": "agent_completed",
          "data": {
            "result": "Mission step complete."
          }
        }
      ]
    },
    {
      "id": "delegation-with-tool-error",
      "steps": [
        {
          "at": 0,
          "actor": "general",
          "type": "agent_started",
          "data": {
            "task": "{{task}}"
          }
        },
        {
          "at": 700,
          "actor": "general",
          "type": "agent_invocation",
          "to": "lead",
          "protocol": "internal",
          "purpose": "{{task}}"
        },
        {
          "at": 800,
          "actor": "lead",
          "type": "agent_started",
          "data": {
            "task": "{{task}}"
          }
        },
        {
          "at": 1500,
          "actor": "lead",
          "type": "agent_invocation",
          "to": "specialist",
          "protocol": "a2a",
          "purpose": "Pull the live numbers from the database"
        },
        {
          "at": 1600,
          "actor": "specialist",
          "type": "agent_started",
          "data": {
            "task": "Pull the live numbers from the database"
          }
        },
        {
          "at": 2300,
          "actor": "specialist",
          "type": "tool_call",
          "tool": "database",
          "arguments": {
            "query": "SELECT * FROM invoices WHERE age_days > 30"
          }
        },
        {
          "at": 4800,
          "actor": "specialist",
          "type": "agent_error",
          "tool": "database",
          "error": "Tool 'database' failed: connection refused to postgres:5432 (timed out after 10s). The specialist stopped; no data was returned.",
          "message": "Tool 'database' failed: connection refused to postgres:5432"
        },
        {
          "at": 5600,
          "actor": "lead",
          "type": "agent_responding",
          "data": {}
        },
        {
          "at": 6600,
          "actor": "lead",
          "type": "agent_completed",
          "data": {
            "result": "Reported the failure upward with the error text; no fabricated numbers."
          }
        },
        {
          "at": 7000,
          "actor": "general",
          "type": "agent_responding",
          "data": {}
        },
        {
          "at": 8000,
          "actor": "general",
          "type": "agent_completed",
          "data": {
            "result": "Escalated: database unreachable."
          }
        }
      ]
    }
