          "to": "specialist",
          "protocol": "{{protocol}}",
          "purpose": "Run the detailed analysis"
        },
        {
          "at": 4700,
          "actor": "specialist",
          "type": "agent_started",
          "data": {
            "task": "Run the detailed analysis"
          }
        },
        {
          "at": 5300,
          "actor": "specialist",
          "type": "tool_call",
          "tool": "{{specialistTool}}",
          "arguments": {
            "input": "{{task}}"
          }
        },
        {
          "at": 6600,
          "actor": "specialist",
          "type": "tool_result",
          "tool": "{{specialistTool}}",
          "result": {
            "ok": true
          }
        },
        {
          "at": 7200,
          "actor": "specialist",
          "type": "agent_responding",
          "data": {}
        },
        {
          "at": 8200,
          "actor": "specialist",
