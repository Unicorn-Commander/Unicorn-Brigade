# Dr. Glitter Mane Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3333
NODE_ENV=development

# Database
DATABASE_URL="file:./data/dr_glitter_mane.db"

# AI Provider (Choose one or configure multiple)
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# OpenRouter (Recommended for multiple models)
OPENROUTER_API_KEY=sk-or-v1-000000000000000000000000000000000000
OPENROUTER_MODEL=openai/gpt-4-turbo-preview

# Local Ollama (for offline use)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2:70b

# Security
JWT_SECRET=your-secret-key-here-min-32-characters
ENCRYPTION_KEY=your-encryption-key-32-characters

# File Storage
UPLOAD_PATH=./data/medical_records
MAX_FILE_SIZE=104857600  # 100MB in bytes

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_RESULTS=10
RAG_SIMILARITY_THRESHOLD=0.7

# Memory Layer
MEMORY_HOT_TIER_DAYS=30
MEMORY_WARM_TIER_DAYS=180
MEMORY_COLD_TIER_DAYS=730
MEMORY_ENABLE_COMPRESSION=true
MEMORY_BACKUP_ENABLED=true

# Optional Services
APACHE_TIKA_URL=http://localhost:9998  # For document processing
LIVEKIT_URL=ws://localhost:7880        # For voice features
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=