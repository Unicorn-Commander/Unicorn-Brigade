{
  "version": "1.0.0",
  "lastUpdated": "2025-09-25T18:47:00.000Z",
  "description": "UC2 Tool Registry - Master catalog of all available tools",
  "schema": "https://json-schema.org/draft/2020-12/schema",
  "tools": {
    "calculator": {
      "name": "calculator",
      "version": "1.0.0",
      "type": "internal",
      "category": "math",
      "description": "Performs safe mathematical calculations",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/calculator.js",
      "permissions": ["basic"],
      "dependencies": [],
      "status": "stable",
      "lastTested": "2025-09-25T12:00:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "Mathematical expression to evaluate"
          },
          "precision": {
            "type": "number",
            "default": 10,
            "description": "Decimal precision for results"
          }
        },
        "required": ["expression"]
      },
      "examples": [
        {
          "description": "Basic arithmetic",
          "input": { "expression": "2 + 3 * 4" },
          "expectedOutput": { "result": 14 }
        },
        {
          "description": "Trigonometry",
          "input": { "expression": "sin(Math.PI / 2)" },
          "expectedOutput": { "result": 1 }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "low",
        "dataAccess": "none"
      },
      "performance": {
        "avgExecutionTime": "5ms",
        "memoryUsage": "minimal",
        "cpuIntensive": false
      }
    },
    "webSearch": {
      "name": "webSearch",
      "version": "1.0.0",
      "type": "internal",
      "category": "search",
      "description": "Search the web using various search engines and APIs",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/webSearch.js",
      "permissions": ["network", "api"],
      "dependencies": ["https", "http"],
      "status": "stable",
      "lastTested": "2025-09-25T12:00:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query string"
          },
          "engine": {
            "type": "string",
            "enum": ["duckduckgo", "searx", "google", "bing"],
            "default": "duckduckgo",
            "description": "Search engine to use"
          },
          "limit": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 50,
            "description": "Maximum number of results to return"
          },
          "safe": {
            "type": "boolean",
            "default": true,
            "description": "Enable safe search filter"
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "Language code for search results"
          }
        },
        "required": ["query"]
      },
      "examples": [
        {
          "description": "Basic web search",
          "input": { "query": "UC2 artificial intelligence" },
          "expectedOutput": { "count": 10, "engine": "duckduckgo" }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "medium",
        "dataAccess": "external",
        "notes": "Makes external API calls"
      },
      "performance": {
        "avgExecutionTime": "500ms",
        "memoryUsage": "low",
        "cpuIntensive": false,
        "networkDependent": true
      },
      "configuration": {
        "environmentVariables": [
          "SEARX_URL",
          "GOOGLE_SEARCH_API_KEY",
          "GOOGLE_SEARCH_ENGINE_ID",
          "BING_SEARCH_API_KEY"
        ]
      }
    },
    "filesystem": {
      "name": "filesystem",
      "version": "1.0.0",
      "type": "internal",
      "category": "file",
      "description": "Perform sandboxed file operations with security controls",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/filesystem.js",
      "permissions": ["filesystem", "read", "write"],
      "dependencies": ["fs", "path", "crypto"],
      "status": "stable",
      "lastTested": "2025-09-25T12:00:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["read", "write", "append", "delete", "list", "exists", "info", "mkdir", "copy", "move"],
            "description": "File operation to perform"
          },
          "path": {
            "type": "string",
            "description": "File or directory path (relative to sandbox)"
          },
          "content": {
            "type": "string",
            "description": "Content to write (for write/append operations)"
          },
          "encoding": {
            "type": "string",
            "enum": ["utf8", "base64", "binary"],
            "default": "utf8",
            "description": "File encoding"
          },
          "recursive": {
            "type": "boolean",
            "default": false,
            "description": "Recursive operation"
          }
        },
        "required": ["operation", "path"]
      },
      "examples": [
        {
          "description": "Read a file",
          "input": { "operation": "read", "path": "data/sample.txt" },
          "expectedOutput": { "content": "file content", "size": 123 }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "medium",
        "dataAccess": "sandboxed",
        "sandboxPaths": ["/tmp/uc2-sandbox", "data/", "uploads/", "temp/"],
        "restrictions": [
          "No path traversal",
          "No system directory access",
          "Limited to sandbox paths"
        ]
      },
      "performance": {
        "avgExecutionTime": "50ms",
        "memoryUsage": "variable",
        "cpuIntensive": false,
        "diskDependent": true
      }
    },
    "database": {
      "name": "database",
      "version": "1.0.0",
      "type": "internal",
      "category": "database",
      "description": "Execute safe database queries using Prisma ORM",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/database.js",
      "permissions": ["database", "read", "write"],
      "dependencies": ["@prisma/client"],
      "status": "stable",
      "lastTested": "2025-09-25T12:00:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0",
        "prisma": ">=4.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["find", "findMany", "findFirst", "findUnique", "create", "update", "upsert", "delete", "deleteMany", "count", "aggregate"],
            "description": "Database operation to perform"
          },
          "model": {
            "type": "string",
            "enum": ["agent", "agentMessage", "agentTask", "orchestration", "memory", "tool", "workflow", "aiProvider", "user", "session"],
            "description": "Database model to operate on"
          },
          "data": {
            "type": "object",
            "description": "Data for create/update operations"
          },
          "where": {
            "type": "object",
            "description": "Filter conditions"
          },
          "take": {
            "type": "number",
            "maximum": 1000,
            "description": "Limit results"
          }
        },
        "required": ["operation", "model"]
      },
      "examples": [
        {
          "description": "Find active agents",
          "input": {
            "operation": "findMany",
            "model": "agent",
            "where": { "status": "active" }
          },
          "expectedOutput": { "count": 3, "result": [] }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "high",
        "dataAccess": "database",
        "restrictions": [
          "No raw SQL queries",
          "Sensitive field filtering",
          "Permission-based access",
          "Rate limiting",
          "Result count limits"
        ],
        "sensitiveFields": {
          "user": ["password"],
          "session": ["token"],
          "aiProvider": ["apiKey"]
        }
      },
      "performance": {
        "avgExecutionTime": "100ms",
        "memoryUsage": "variable",
        "cpuIntensive": false,
        "databaseDependent": true
      }
    },
    "chartGenerator": {
      "name": "chartGenerator",
      "version": "1.0.0",
      "type": "internal",
      "category": "visualization",
      "description": "Generate professional charts and data visualizations",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/chartGenerator.js",
      "permissions": ["basic", "filesystem"],
      "dependencies": ["chart.js", "canvas", "chartjs-node-canvas"],
      "status": "stable",
      "lastTested": "2025-09-25T18:47:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["bar", "line", "pie", "doughnut", "scatter", "radar", "polarArea", "bubble"],
            "description": "Type of chart to generate"
          },
          "data": {
            "type": "object",
            "description": "Chart data - can include labels, datasets, etc."
          },
          "csvData": {
            "type": "string",
            "description": "CSV formatted data to convert to chart"
          },
          "jsonData": {
            "type": "object",
            "description": "JSON data array to convert to chart"
          },
          "outputFormat": {
            "type": "string",
            "enum": ["png", "jpeg", "svg", "html", "json"],
            "default": "png",
            "description": "Output format for the chart"
          },
          "theme": {
            "type": "string",
            "enum": ["default", "dark", "light", "colorful", "minimal"],
            "default": "default",
            "description": "Chart color theme"
          }
        },
        "required": ["type"]
      },
      "examples": [
        {
          "description": "Simple bar chart",
          "input": {
            "type": "bar",
            "data": {
              "labels": ["A", "B", "C"],
              "datasets": [{ "label": "Values", "data": [10, 20, 30] }]
            }
          },
          "expectedOutput": { "chartType": "bar", "outputFormat": "png" }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "low",
        "dataAccess": "minimal",
        "restrictions": [
          "Canvas rendering only",
          "No external data sources",
          "Limited file output paths"
        ]
      },
      "performance": {
        "avgExecutionTime": "200ms",
        "memoryUsage": "moderate",
        "cpuIntensive": true,
        "canvasDependent": true
      }
    },
    "encryptionTool": {
      "name": "encryptionTool",
      "version": "1.0.0",
      "type": "internal",
      "category": "security",
      "description": "Comprehensive encryption, decryption, and cryptographic operations",
      "author": "UC2 Core Team",
      "license": "MIT",
      "path": "internal/encryptionTool.js",
      "permissions": ["security", "filesystem"],
      "dependencies": ["crypto"],
      "status": "stable",
      "lastTested": "2025-09-25T18:47:00.000Z",
      "compatibility": {
        "node": ">=16.0.0",
        "uc2": ">=1.0.0"
      },
      "schema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "aes-encrypt", "aes-decrypt",
              "rsa-generate-keys", "rsa-encrypt", "rsa-decrypt",
              "hash", "hmac", "verify-hmac",
              "generate-password", "derive-key",
              "encrypt-file", "decrypt-file",
              "secure-random", "sign", "verify-signature"
            ],
            "description": "Cryptographic operation to perform"
          },
          "data": {
            "type": "string",
            "description": "Data to encrypt/decrypt/hash (string or base64)"
          },
          "key": {
            "type": "string",
            "description": "Encryption key (hex, base64, or string)"
          },
          "algorithm": {
            "type": "string",
            "description": "Algorithm to use (aes-256-gcm, sha256, etc.)"
          }
        },
        "required": ["operation"]
      },
      "examples": [
        {
          "description": "Generate secure password",
          "input": {
            "operation": "generate-password",
            "passwordLength": 20,
            "passwordComplexity": {
              "uppercase": true,
              "lowercase": true,
              "numbers": true,
              "symbols": false
            }
          },
          "expectedOutput": { "password": "secure_password", "entropy": 119.5 }
        }
      ],
      "security": {
        "safe": true,
        "sandboxed": true,
        "riskLevel": "high",
        "dataAccess": "sensitive",
        "restrictions": [
          "Cryptographic key management",
          "Secure random generation",
          "Memory-safe operations",
          "No plaintext key storage"
        ],
        "notes": [
          "All cryptographic operations use Node.js crypto module",
          "Keys and sensitive data should be handled securely",
          "Use strong, unique keys for each encryption operation"
        ]
      },
      "performance": {
        "avgExecutionTime": "50ms",
        "memoryUsage": "variable",
        "cpuIntensive": true,
        "cryptographicOperations": true
      }
    }
  },
