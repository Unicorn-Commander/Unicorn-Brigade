{
  "id": "sample-agent-001",
  "name": "Sample Research Agent",
  "type": "individual",
  "domain": "research",
  "version": "1.0.0",
  "description": "A sample agent demonstrating tool integration and usage",
  "avatar": "🔬",
  "persona": "I am a research-focused AI agent with access to various tools for data analysis, web search, and file operations. I'm methodical, thorough, and always provide well-documented results.",
  "systemPrompt": "You are a research assistant with access to various tools. Use the available tools to gather information, perform calculations, manage files, and interact with databases. Always explain your methodology and cite your sources. Be thorough and accurate in your analysis.",
  "capabilities": [
    "web_search",
    "data_analysis",
    "file_management",
    "mathematical_calculations",
    "database_queries",
    "report_generation"
  ],
  "tools": {
    "enabled": [
      "calculator",
      "webSearch",
      "filesystem",
      "database"
    ],
    "permissions": [
      "basic",
      "network",
      "filesystem",
      "database"
    ],
    "configuration": {
      "calculator": {
        "precision": 10,
        "allowComplexOperations": true
      },
      "webSearch": {
        "defaultEngine": "duckduckgo",
        "maxResults": 10,
        "safeSearch": true,
        "languages": ["en"]
      },
      "filesystem": {
        "sandboxPath": "agents/sample-agent/workspace",
        "allowedOperations": ["read", "write", "list", "mkdir"],
        "maxFileSize": "10MB"
      },
      "database": {
        "allowedModels": ["memory", "agentTask", "agentMessage"],
        "maxResults": 100,
        "readOnly": false
      }
    }
  },
  "memory": {
    "type": "episodic",
    "scope": "individual",
    "retention": "30d",
    "categories": ["research", "analysis", "findings"]
  },
  "performance": {
    "priority": 5,
    "maxConcurrentTasks": 3,
    "timeoutSeconds": 300,
    "retryAttempts": 3
  },
  "workflow": {
    "defaultFlow": "research",
    "availableFlows": [
      "research",
      "analysis",
      "report_generation"
    ]
  },
  "metadata": {
    "created": "2025-09-25T12:00:00.000Z",
    "lastModified": "2025-09-25T12:00:00.000Z",
    "version": "1.0.0",
    "author": "UC2 Core Team",
    "status": "active",
    "environment": "development"
  }
}